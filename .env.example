# Публичный адрес сайта. После подключения домена замените пример своим адресом.
NEXT_PUBLIC_SITE_URL=https://example.ru

# PostgreSQL в Timeweb Cloud. Секретные значения задаются только в переменных приложения.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=/app/certs/timeweb-ca.crt

# Будет добавлен перед включением сохранения обращений.
# Случайный ключ нужен для шифрования вопросов и ответов на сервере.
CONSULTATION_ENCRYPTION_KEY=

# Закрытый кабинет консультанта. Используйте длинную случайную строку.
CONSULTANT_ACCESS_KEY=

# Реквизиты ЮKassa уже должны быть заданы в Timeweb.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Timeweb AI Gateway используется только на сервере для черновиков в кабинете консультанта.
TIMEWEB_AI_API_KEY=
# Необязательно: можно заменить модель и адрес шлюза без изменения кода.
TIMEWEB_AI_MODEL=dashscope/qwen3.5-plus
TIMEWEB_AI_BASE_URL=https://api.timeweb.ai/v1
